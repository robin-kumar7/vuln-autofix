#!/usr/bin/env bash
# Centralized threshold configuration for auto-vuln-fixer
# These values are used across version-selector.sh, parse-fix.sh, and other scripts

# ============================================================================
# Retry Configuration
# ============================================================================
# Number of retry attempts for network operations (wizcli download, git pull, etc.)
RETRY_ATTEMPTS=3

# Delay in seconds between retry attempts
RETRY_DELAY_SECONDS=5

# ============================================================================
# Version Safety Scores (0.0-1.0 range, where 1.0 = safest, 0.0 = riskiest)
# ============================================================================
# Risk score for major version bumps (e.g., 1.x -> 2.x)
# Lower score indicates higher risk and manual review requirement
VERSION_SAFETY_MAJOR=0.60

# Risk score for minor version bumps (e.g., 1.2 -> 1.3)
# Medium risk; may introduce API changes but generally safer than major bumps
VERSION_SAFETY_MINOR=0.85

# Risk score for patch-only updates (e.g., 1.2.3 -> 1.2.4)
# Highest safety score; patch releases typically contain only bug fixes
VERSION_SAFETY_PATCH=0.95

# Fallback risk score for versions that cannot be parsed (e.g., custom/malformed versions)
# Medium risk default to prevent auto-applying unknown version schemes
VERSION_SAFETY_UNPARSEABLE=0.50

# ============================================================================
# Version Jump Guardrails
# ============================================================================
# Whether to skip fixes that involve any major version jump
# Set to "true" to enable guardrail (skip fixes), "false" to allow all major bumps
SKIP_MAJOR_JUMP=true

# Maximum allowed minor version jump threshold
# If a fix requires jumping more than N minor versions, it will be skipped
# Example: if set to 10, a jump from 1.5 -> 1.16 would be skipped
SKIP_MINOR_JUMP_THRESHOLD=20

# ============================================================================
# Severity Rank Weights (for risk scoring algorithm)
# ============================================================================
# These values are used in risk-score.sh to rank vulnerability severity
# Higher numbers = more severe, more urgent to fix
SEVERITY_RANK_CRITICAL=5
SEVERITY_RANK_HIGH=4
SEVERITY_RANK_MEDIUM=3
SEVERITY_RANK_LOW=2
SEVERITY_RANK_INFO=1
